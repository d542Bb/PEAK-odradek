<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>d542Bb.TerrainScanner</AssemblyName>
    <AssemblyTitle>TerrainScanner</AssemblyTitle>
    <Version>1.1.5</Version>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE;DEBUGUI</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PEAKModding.PEAKLib.Core" Version="1.7.2" />
    <PackageReference Include="Cysharp-UniTask" Version="2.5.0" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1" />
  </ItemGroup>

  <!--
    引用 PEAK 游戏自带的 Unity 引擎 / URP / DOTween 托管 DLL（只读引用，不复制、不修改游戏目录）。
    路径来自 Directory.Build.props 的 $(ManagedDir)（游戏 PEAK_Data/Managed/）。
  -->
  <ItemGroup>
    <TSManaged Include="$(ManagedDir)UnityEngine*.dll" />
    <TSManaged Include="$(ManagedDir)Unity.RenderPipelines*.dll" />
    <TSManaged Include="$(ManagedDir)Unity.Collections.dll" />
    <TSManaged Include="$(ManagedDir)Unity.Mathematics.dll" />
    <TSManaged Include="$(ManagedDir)Unity.Burst.dll" />
    <TSManaged Include="$(ManagedDir)Unity.Burst.Unsafe.dll" />
    <TSManaged Include="$(ManagedDir)Unity.Profiling.Core.dll" />
    <TSManaged Include="$(ManagedDir)Unity.TextMeshPro.dll" />
    <TSManaged Include="$(ManagedDir)DOTween.dll" />
    <TSManaged Include="$(ManagedDir)DOTweenPro.dll" />
    <TSManaged Include="$(ManagedDir)DemiLib.dll" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="@(TSManaged->'%(Filename)')">
      <HintPath>%(TSManaged.Identity)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>